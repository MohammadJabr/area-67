# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Notebooks
.ipynb_checkpoints/

# Environment / secrets
.env
.env.*
!.env.example

# Large geospatial data (keep only explicitly curated small samples)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
data/**/*.tif
data/**/*.tiff
data/**/*.TIF
data/**/*.TIFF
data/**/*.img
data/**/*.IMG
data/**/*.img.aux.xml
data/**/*.vrt
data/**/*.VRT
data/**/*.jp2
data/**/*.JP2
data/**/*.zip
data/**/*.tar
data/**/*.tar.*
data/**/*.tgz
data/**/*.gz
data/**/*.7z
data/**/*.rar
data/**/*.h5
data/**/*.nc
!data/sample/**
*.part

# Local outputs
outputs/
reports/generated/
*.log

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/


# Small app-facing handoff artifacts are versioned so the team can integrate
# Hiba's fingerprints and Omar's rankings. Large raster/binary files remain
# ignored by the rules above.
!data/processed/*.csv
!data/processed/*.json
!data/processed/*.geojson
!data/processed/*.md
!data/processed/exploratory_mvp_2026-11-15/
data/processed/exploratory_mvp_2026-11-15/*
!data/processed/exploratory_mvp_2026-11-15/terrain_fingerprints.csv
!data/processed/exploratory_mvp_2026-11-15/candidate_rankings.csv
!data/processed/exploratory_mvp_2026-11-15/ranking_robustness.json
!data/processed/exploratory_mvp_2026-11-15/README.md
